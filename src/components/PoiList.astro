---
import { categoryId, editionId, isProminent, type CategoryEntry, type PoiEntry } from "../lib/poi";

interface Props {
  pois: PoiEntry[];
  categories: CategoryEntry[];
}

const { pois, categories } = Astro.props;
const names = new Map(categories.map((category) => [category.data.slug, category.data.name]));
---

{pois.length === 0 ? (
  <p class="empty-state" role="status">
    Curation for this edition is incomplete. No published places are available yet.
  </p>
) : (
  <ul class="poi-list">
    {pois.map((poi) => {
      const prominent = isProminent(poi);
      const categoryName = names.get(categoryId(poi)) ?? "Unknown category";
      return (
        <li class={prominent ? "prominent" : undefined}>
          <a
            href={`/poi/${editionId(poi)}/${poi.data.slug}/`}
            id={`poi-${poi.data.slug}`}
            data-poi-slug={poi.data.slug}
          >
            {poi.data.name}
            {prominent ? " (highlighted care landmark)" : ""}
          </a>
          <span> — {categoryName}</span>
        </li>
      );
    })}
  </ul>
)}

<script>
  import { dispatchPoiSelect } from "../scripts/map/selection";

  const returnFocusKey = "poi-return-focus";
  const links = [...document.querySelectorAll<HTMLAnchorElement>("a[data-poi-slug]")];

  for (const link of links) {
    link.addEventListener("focus", () => dispatchPoiSelect(window, link.dataset.poiSlug ?? null));
    link.addEventListener("click", () => {
      try {
        window.sessionStorage.setItem(returnFocusKey, link.dataset.poiSlug ?? "");
      } catch {
        // Storage may be unavailable; semantic navigation must still work.
      }
    });
  }

  try {
    const hashSlug = window.location.hash.slice(1);
    if (hashSlug && hashSlug === window.sessionStorage.getItem(returnFocusKey)) {
      window.sessionStorage.removeItem(returnFocusKey);
      requestAnimationFrame(() => {
        document.querySelector<HTMLAnchorElement>(`a[data-poi-slug='${CSS.escape(hashSlug)}']`)?.focus();
      });
    }
  } catch {
    // Focus restoration is progressive enhancement when storage is unavailable.
  }
</script>
