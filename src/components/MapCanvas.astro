---
import { isProminent, type PoiEntry } from "../lib/poi";

interface Props {
  pois: PoiEntry[];
}

const { pois } = Astro.props;
const mapPois = pois.map((poi) => ({
  slug: poi.data.slug,
  x: poi.data.plan.x,
  y: poi.data.plan.y,
  prominent: isProminent(poi),
}));
---

<div class="map-display">
  <div
    class="map-enhancement"
    data-map-enhancement
    data-webgl="pending"
    data-pois={JSON.stringify(mapPois)}
    data-plan-url="/map/boom-2025/plan-base.svg"
    data-render-count="0"
  >
    <img
      class="map-placeholder"
      src="/map/boom-2025/plan-base.svg"
      alt="Original placeholder plan of the Boom 2025 site with labeled zones"
      width="960"
      height="640"
    />
    <canvas class="map-canvas" aria-hidden="true" tabindex="-1"></canvas>
    <div class="map-controls" role="group" aria-label="Map view controls">
      <button type="button" aria-label="Zoom in" disabled data-map-action="zoom-in">+</button>
      <button type="button" aria-label="Zoom out" disabled data-map-action="zoom-out">−</button>
      <button type="button" aria-label="Reset view" disabled data-map-action="reset">Reset</button>
    </div>
  </div>
  <p class="map-guidance">Drag to explore. Use the controls to zoom. This is a schematic placeholder plan, not a geographically precise map.</p>
  <ul class="map-legend" aria-label="Map marker legend">
    <li><span class="legend-swatch legend-swatch-ordinary" aria-hidden="true"></span>Ordinary places</li>
    <li><span class="legend-swatch legend-swatch-care" aria-hidden="true"></span>Highlighted care landmarks</li>
  </ul>
</div>

<script>
  import { listenForPoiSelect } from "../scripts/map/selection";
  import { supportsWebGl } from "../scripts/map/webgl-check";
  import type { MapPoi, MapSceneHandle } from "../scripts/map/scene";

  const setupMap = async (host: HTMLElement) => {
    const canvas = host.querySelector<HTMLCanvasElement>("canvas");
    const controls = [...host.querySelectorAll<HTMLButtonElement>("[data-map-action]")];

    if (!canvas) {
      return;
    }

    const links = [...document.querySelectorAll<HTMLAnchorElement>("a[data-poi-slug]")];
    const controller = new AbortController();
    let scene: MapSceneHandle | undefined;
    let disposed = false;
    const dispose = () => {
      if (disposed) {
        return;
      }
      disposed = true;
      controller.abort();
      scene?.dispose();
    };

    window.addEventListener("pagehide", dispose, { once: true, signal: controller.signal });

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    host.dataset.motion = reducedMotion ? "reduce" : "standard";

    listenForPoiSelect(
      window,
      (slug) => {
        host.dataset.selectedPoi = slug ?? "";
        for (const link of links) {
          const selected = link.dataset.poiSlug === slug;
          if (selected) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        }
      },
      controller.signal,
    );

    if (!supportsWebGl()) {
      host.dataset.webgl = "unavailable";
      return;
    }

    try {
      host.dataset.webgl = "loading";
      const { createMapScene } = await import("../scripts/map/scene");
      if (disposed) {
        return;
      }
      const pois = JSON.parse(host.dataset.pois ?? "[]") as MapPoi[];
      scene = createMapScene({
        canvas,
        planUrl: host.dataset.planUrl ?? "",
        pois,
        onRender: () => {
          host.dataset.renderCount = String(Number(host.dataset.renderCount ?? "0") + 1);
        },
        onTextureReady: () => {
          if (!disposed) {
            host.dataset.webgl = "ready";
            controls.forEach((control) => { control.disabled = false; });
          }
        },
        onTextureError: () => {
          if (disposed) return;
          controls.forEach((control) => { control.disabled = true; });
          scene?.dispose();
          scene = undefined;
          host.dataset.webgl = "unavailable";
        },
        onMarkerActivate: (slug) => {
          if (disposed) return;
          const link = links.find((candidate) => candidate.dataset.poiSlug === slug);
          if (!link) return;
          try {
            window.sessionStorage.setItem("poi-return-focus", slug);
          } catch {
            // Storage is optional; marker navigation must still work.
          }
          window.location.assign(link.href);
        },
      });
      for (const control of controls) {
        control.addEventListener("click", () => {
          if (disposed || control.disabled || !scene) return;
          switch (control.dataset.mapAction) {
            case "zoom-in": scene.zoomIn(); break;
            case "zoom-out": scene.zoomOut(); break;
            case "reset": scene.resetView(); break;
          }
        }, { signal: controller.signal });
      }
    } catch {
      scene?.dispose();
      if (!disposed) {
        host.dataset.webgl = "unavailable";
      }
    }
  };

  for (const host of document.querySelectorAll<HTMLElement>("[data-map-enhancement]")) {
    void setupMap(host);
  }
</script>
