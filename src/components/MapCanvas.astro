---
import { getCollection } from "astro:content";
import { categoryId, isProminent, type PoiEntry } from "../lib/poi";
import CategoryIcon from "./CategoryIcon.astro";

interface Props {
  pois: PoiEntry[];
}

const { pois } = Astro.props;
const categories = await getCollection("categories");
const categoryNames = new Map(categories.map((category) => [category.data.slug, category.data.name]));
const visibleCategories = categories.filter((category) => pois.some((poi) => categoryId(poi) === category.data.slug));
const mapPois = pois.map((poi) => ({
  slug: poi.data.slug,
  name: poi.data.name,
  category: categoryId(poi),
  categoryName: categoryNames.get(categoryId(poi)) ?? "Unknown category",
  x: poi.data.plan.x,
  y: poi.data.plan.y,
  prominent: isProminent(poi),
}));
---

<div class="map-display">
  <div
    class="map-enhancement"
    data-map-enhancement
    data-webgl="pending"
    data-pois={JSON.stringify(mapPois)}
    data-plan-url="/map/boom-2025/plan-base.svg"
    data-render-count="0"
  >
    <img
      class="map-placeholder"
      src="/map/boom-2025/plan-base.svg"
      alt="Independent schematic plan with labeled lake, bowl, grove, culture, healing and camping areas"
      width="960"
      height="640"
    />
    <canvas class="map-canvas" aria-hidden="true" tabindex="-1"></canvas>
    <div class="map-controls" role="group" aria-label="Map view controls">
      <button type="button" aria-label="Zoom in" disabled data-map-action="zoom-in">+</button>
      <button type="button" aria-label="Zoom out" disabled data-map-action="zoom-out">−</button>
      <button type="button" aria-label="Reset view" disabled data-map-action="reset">Reset</button>
    </div>
  </div>
  <section class="map-preview" aria-label="Map place preview" tabindex="-1" data-map-preview hidden>
    <span class="marker-icon" data-preview-icon aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path /></svg>
    </span>
    <div class="map-preview-copy">
      <strong data-preview-name></strong>
      <span data-preview-category></span>
      <a data-preview-link>View place<span aria-hidden="true"> →</span></a>
    </div>
    <button type="button" class="map-preview-close" aria-label="Dismiss place preview" data-preview-close>×</button>
  </section>
  <p class="map-guidance">Drag to explore. Use the controls to zoom. On touch screens, pinch with two fingers to zoom, or tap a marker to preview it. Hover a marker or focus a place in the list to see its name. Choose View on map to locate a place. This is a schematic placeholder plan, not a geographically precise map.</p>
  <ul class="map-legend" aria-label="Map marker legend">
    {visibleCategories.map((category) => (
      <li data-marker-category={category.data.slug}>
        <CategoryIcon category={category.data.slug} />
        {category.data.name}
      </li>
    ))}
  </ul>
</div>

<script>
  import { dispatchPoiSelect, listenForPoiSelect } from "../scripts/map/selection";
  import { markerStyle } from "../lib/map-markers";
  import { supportsWebGl } from "../scripts/map/webgl-check";
  import type { MapPoi, MapSceneHandle } from "../scripts/map/scene";

  const setupMap = async (host: HTMLElement) => {
    const canvas = host.querySelector<HTMLCanvasElement>("canvas");
    const controls = [...host.querySelectorAll<HTMLButtonElement>("[data-map-action]")];
    const display = host.closest<HTMLElement>(".map-display");
    const preview = display?.querySelector<HTMLElement>("[data-map-preview]");
    const previewName = preview?.querySelector<HTMLElement>("[data-preview-name]");
    const previewCategory = preview?.querySelector<HTMLElement>("[data-preview-category]");
    const previewIcon = preview?.querySelector<HTMLElement>("[data-preview-icon]");
    const previewPath = previewIcon?.querySelector("path");
    const previewLink = preview?.querySelector<HTMLAnchorElement>("[data-preview-link]");
    const previewClose = preview?.querySelector<HTMLButtonElement>("[data-preview-close]");

    if (!canvas) {
      return;
    }

    const links = [...document.querySelectorAll<HTMLAnchorElement>("a[data-poi-slug]")];
    const controller = new AbortController();
    let scene: MapSceneHandle | undefined;
    let pendingSlug = new URL(window.location.href).searchParams.get("poi");
    let disposed = false;
    const dispose = () => {
      if (disposed) {
        return;
      }
      disposed = true;
      controller.abort();
      scene?.dispose();
    };

    window.addEventListener("pagehide", dispose, { once: true, signal: controller.signal });

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    host.dataset.motion = reducedMotion ? "reduce" : "standard";

    listenForPoiSelect(
      window,
      (slug) => {
        host.dataset.selectedPoi = slug ?? "";
        for (const link of links) {
          const selected = link.dataset.poiSlug === slug;
          if (selected) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        }
      },
      controller.signal,
    );

    if (!supportsWebGl()) {
      host.dataset.webgl = "unavailable";
      return;
    }

    const locatePending = () => {
      if (disposed || !pendingSlug) return;
      display?.dispatchEvent(new Event("map:show-illustrated", { bubbles: true }));
      if (host.dataset.webgl !== "ready" || !scene) return;
      const slug = pendingSlug;
      pendingSlug = null;
      if (!scene.focusPoi(slug)) return;
      display?.scrollIntoView({ block: "start", behavior: "auto" });
      preview?.focus({ preventScroll: true });
    };
    const fallbackPending = () => {
      const link = links.find((link) => link.dataset.poiSlug === pendingSlug);
      pendingSlug = null;
      link?.focus();
    };
    for (const action of host.closest(".map-workspace")?.querySelectorAll<HTMLAnchorElement>("[data-map-locate]") ?? []) {
      action.addEventListener("click", (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || host.dataset.webgl === "unavailable") return;
        event.preventDefault();
        window.history.pushState(null, "", action.href);
        pendingSlug = action.dataset.mapLocate ?? null;
        locatePending();
      }, { signal: controller.signal });
    }
    window.addEventListener("popstate", () => {
      pendingSlug = new URL(window.location.href).searchParams.get("poi");
      locatePending();
    }, { signal: controller.signal });

    const rememberReturnFocus = (slug: string) => {
      try {
        window.sessionStorage.setItem("poi-return-focus", slug);
      } catch {
        // Storage is optional; marker navigation must still work.
      }
    };
    const dismissPreview = () => {
      if (!preview || preview.hidden) return;
      const slug = preview.dataset.slug;
      if (preview.contains(document.activeElement)) {
        links.find((link) => link.dataset.poiSlug === slug)?.focus();
      }
      dispatchPoiSelect(window, null);
    };
    previewClose?.addEventListener("click", dismissPreview, { signal: controller.signal });
    previewLink?.addEventListener("click", () => {
      if (preview?.dataset.slug) rememberReturnFocus(preview.dataset.slug);
    }, { signal: controller.signal });
    preview?.addEventListener("focusin", () => {
      if (preview.dataset.slug && host.dataset.selectedPoi !== preview.dataset.slug) {
        dispatchPoiSelect(window, preview.dataset.slug);
      }
    }, { signal: controller.signal });
    display?.addEventListener("pointerleave", () => scene?.clearHover(), { signal: controller.signal });
    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && preview && !preview.hidden) {
        event.preventDefault();
        dismissPreview();
      }
    }, { signal: controller.signal });

    try {
      host.dataset.webgl = "loading";
      const { createMapScene } = await import("../scripts/map/scene");
      if (disposed) {
        return;
      }
      const pois = JSON.parse(host.dataset.pois ?? "[]") as MapPoi[];
      scene = createMapScene({
        canvas,
        planUrl: host.dataset.planUrl ?? "",
        pois,
        onRender: () => {
          host.dataset.renderCount = String(Number(host.dataset.renderCount ?? "0") + 1);
        },
        onTextureReady: () => {
          if (!disposed) {
            host.dataset.webgl = "ready";
            controls.forEach((control) => { control.disabled = false; });
            // List focus may be restored before the lazy scene has subscribed.
            if (host.dataset.selectedPoi) dispatchPoiSelect(window, host.dataset.selectedPoi);
            locatePending();
          }
        },
        onTextureError: () => {
          if (disposed) return;
          controls.forEach((control) => { control.disabled = true; });
          scene?.dispose();
          scene = undefined;
          host.dataset.webgl = "unavailable";
          if (preview) preview.hidden = true;
          fallbackPending();
        },
        onMarkerPreview: (poi) => {
          if (disposed || !preview || !previewName || !previewCategory || !previewLink) return;
          const link = links.find((candidate) => candidate.dataset.poiSlug === poi?.slug);
          preview.hidden = !poi || !link;
          if (!poi || !link) return;
          preview.dataset.slug = poi.slug;
          previewName.textContent = poi.name;
          previewCategory.textContent = poi.categoryName;
          previewLink.href = link.href;
          const style = markerStyle(poi.category);
          previewIcon?.style.setProperty("--marker-color", style.color);
          previewPath?.setAttribute("d", style.path);
        },
        onMarkerActivate: (slug) => {
          if (disposed) return;
          const link = links.find((candidate) => candidate.dataset.poiSlug === slug);
          if (!link) return;
          rememberReturnFocus(slug);
          window.location.assign(link.href);
        },
      });
      for (const control of controls) {
        control.addEventListener("click", () => {
          if (disposed || control.disabled || !scene) return;
          switch (control.dataset.mapAction) {
            case "zoom-in": scene.zoomIn(); break;
            case "zoom-out": scene.zoomOut(); break;
            case "reset": scene.resetView(); break;
          }
        }, { signal: controller.signal });
      }
    } catch {
      scene?.dispose();
      if (!disposed) {
        host.dataset.webgl = "unavailable";
        fallbackPending();
      }
    }
  };

  for (const host of document.querySelectorAll<HTMLElement>("[data-map-enhancement]")) {
    void setupMap(host);
  }
</script>
