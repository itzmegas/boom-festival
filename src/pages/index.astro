---
import { getCollection } from "astro:content";
import MapWorkspace from "../components/MapWorkspace.astro";
import UnofficialNotice from "../components/UnofficialNotice.astro";
import "../styles/global.css";
import { CURRENT_EDITION, filterPois } from "../lib/poi";

const [pois, categories] = await Promise.all([getCollection("pois"), getCollection("categories")]);
const visible = filterPois(pois, CURRENT_EDITION, undefined);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Independent Boom 2025 map</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="home-page">
      <div class="home-notice"><UnofficialNotice /></div>
      <main id="main-content" class="home-main" tabindex="-1">
        <header class="home-intro">
          <h1>Independent Boom 2025 map</h1>
          <p>
            Browse a fan-curated, plan-local illustration. This is not GPS, live data,
            or official navigation.
          </p>
        </header>
        <MapWorkspace pois={visible} categories={categories} editionSlug={CURRENT_EDITION} />
      </main>
    </div>
  </body>
</html>
